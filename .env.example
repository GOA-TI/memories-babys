APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Producción: MariaDB/MySQL dedicado (recomendado). Tests usan SQLite en memoria (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samuel_memorias
DB_USERNAME=samuel_memorias
DB_PASSWORD=

# Solo desarrollo offline / migración one-shot desde SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Samuel Memorias (app familiar) ---
SAMUEL_APP_NAME=Samuel
SAMUEL_TAGLINE="Nuestro álbum de recuerdos"
SAMUEL_THEME_PRIMARY=#f472b6
SAMUEL_THEME_SECONDARY=#a78bfa
SAMUEL_ADMIN_SECRET=
# Por archivo (foto o video). Duración orientativa: SAMUEL_UPLOAD_MAX_VIDEO_MINUTES (~3 min).
SAMUEL_UPLOAD_MAX_MB=512
SAMUEL_UPLOAD_MAX_VIDEO_MINUTES=3

SAMUEL_ADMIN_CEDULA=
SAMUEL_ADMIN_PIN=
SAMUEL_ADMIN_NAME=

# Cuentas Google Drive (JSON). Ver README — OAuth, no contraseña de Gmail.
SAMUEL_DRIVE_ACCOUNTS_JSON=[]

# Cloudflare R2 (recomendado — mismo tipo que Lynxux Cash)
SAMUEL_STORAGE_DRIVER=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memorias-samuel
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=
R2_USE_PATH_STYLE_ENDPOINT=false
